{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agenteval.openprojectx.io/v1alpha1"},
    "kind": {"const": "Policy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedRiskLevels", "maxSteps", "timeoutSeconds"],
      "properties": {
        "allowedRiskLevels": {
          "type": "array",
          "items": {"enum": ["read", "write", "destructive"]},
          "uniqueItems": true
        },
        "requireMockForWriteTools": {"type": "boolean"},
        "maxSteps": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
