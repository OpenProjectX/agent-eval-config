{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "cases"],
  "properties": {
    "apiVersion": {"const": "agenteval.openprojectx.io/v1alpha1"},
    "kind": {"const": "Dataset"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"type": "string", "minLength": 1},
          "expectedTools": {"type": "array", "items": {"type": "string"}},
          "expectedContains": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
